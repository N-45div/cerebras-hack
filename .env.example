# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Required: Cerebras Inference (https://cloud.cerebras.ai)
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=moonshotai-kimi-k3.1-pro-trial

# Optional: engine tuning
# LLM_CONCURRENCY=64        # calls in flight at once (one wave is fastest under load)
# TABS_PER_CALL=4           # tabs judged per Kimi call
# REASONING_EFFORT=low      # Kimi always reasons; low is the minimum
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# CDP_PORT=9333             # the dedicated Tab Bankruptcy Chrome profile
# DASHBOARD_PORT=4747

# Optional: tools/bench/kimi-race.mjs (Kimi on Moonshot's own platform, for Kimi vs Kimi)
# MOONSHOT_API_KEY=

# Optional: tools/video/voiceover.mjs
# ELEVENLABS_API_KEY=

# Optional: Speed Bounty runs used context.dev search/scrape through OpenClaw MCP
# CONTEXT_DEV_API_KEY=
